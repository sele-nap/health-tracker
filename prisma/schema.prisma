generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  emailVerified  Boolean   @default(false)
  name           String?
  image          String?
  locale         String    @default("en")
  timezone       String    @default("Europe/Paris")
  twoFactorEnabled Boolean  @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sessions       Session[]
  twoFactors     TwoFactor[]
  accounts       Account[]
  conditions     UserCondition[]
  symptomLogs    SymptomLog[]
  medications    Medication[]
  appointments   Appointment[]

  @@index([email])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Account {
  id           String    @id @default(cuid())
  userId       String
  accountId    String
  providerId   String
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  password     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model UserCondition {
  id          String    @id @default(cuid())
  userId      String
  name        String
  diagnosedAt DateTime?
  createdAt   DateTime  @default(now())

  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  symptomDefinitions  SymptomDefinition[]

  @@index([userId])
}

model SymptomDefinition {
  id          String  @id @default(cuid())
  conditionId String
  name        String
  unit        String?
  isDefault   Boolean @default(false)

  condition   UserCondition    @relation(fields: [conditionId], references: [id], onDelete: Cascade)
  entries     SymptomLogEntry[]

  @@index([conditionId])
}

model SymptomLog {
  id           String   @id @default(cuid())
  userId       String
  loggedAt     DateTime @default(now())
  overallMood  Int?
  energyLevel  Int?
  sleepHours   Float?
  sleepQuality Int?
  stressLevel  Int?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries      SymptomLogEntry[]

  @@index([userId, loggedAt])
}

model SymptomLogEntry {
  id                  String   @id @default(cuid())
  symptomLogId        String
  symptomDefinitionId String
  value               String
  severity            Int?
  createdAt           DateTime @default(now())

  symptomLog          SymptomLog        @relation(fields: [symptomLogId], references: [id], onDelete: Cascade)
  symptomDefinition   SymptomDefinition @relation(fields: [symptomDefinitionId], references: [id], onDelete: Cascade)

  @@index([symptomLogId])
}

model Medication {
  id           String    @id @default(cuid())
  userId       String
  name         String
  dosage       String
  form         String?
  prescribedBy String?
  startDate    DateTime
  endDate      DateTime?
  instructions String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedules    ReminderSchedule[]
  logs         MedicationLog[]

  @@index([userId, isActive])
}

model ReminderSchedule {
  id              String   @id @default(cuid())
  medicationId    String
  frequency       String
  times           String[]
  daysOfWeek      Int[]
  reminderEnabled Boolean  @default(true)
  createdAt       DateTime @default(now())

  medication      Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)

  @@index([medicationId])
}

model MedicationLog {
  id           String           @id @default(cuid())
  medicationId String
  scheduledFor DateTime
  takenAt      DateTime?
  status       MedicationStatus
  notes        String?
  createdAt    DateTime         @default(now())

  medication   Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)

  @@index([medicationId, scheduledFor])
}

enum MedicationStatus {
  TAKEN
  SKIPPED
  DELAYED
  PENDING
}

model Appointment {
  id             String            @id @default(cuid())
  userId         String
  title          String
  doctorName     String?
  specialty      String?
  location       String?
  scheduledAt    DateTime
  durationMin    Int?
  status         AppointmentStatus @default(UPCOMING)
  purpose        String?
  summary        String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes          AppointmentNote[]

  @@index([userId, scheduledAt])
}

enum AppointmentStatus {
  UPCOMING
  COMPLETED
  CANCELLED
  RESCHEDULED
}

model AppointmentNote {
  id            String   @id @default(cuid())
  appointmentId String
  content       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
}

model TwoFactor {
  id          String  @id @default(cuid())
  userId      String
  secret      String
  backupCodes String

  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}
